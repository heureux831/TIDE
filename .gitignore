.DS_Store
.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Downloaded data and model weights are reproducible, large, or access-controlled.
data/downloads/*
data/annotated/*
models/*
cache/
runs/*

# Keep directory intent without committing generated artifacts.
!data/downloads/.gitkeep
!data/annotated/.gitkeep
!models/.gitkeep
!runs/.gitkeep
