# Copy this file to .env and fill only the values needed for the command you run.
# Never commit .env or print token values in logs.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Set these from the provider's current pricing page before paid annotation.
DEEPSEEK_INPUT_USD_PER_MILLION=
DEEPSEEK_OUTPUT_USD_PER_MILLION=

# Optional for gated/private Hugging Face assets. Public models normally work empty.
HF_TOKEN=
HF_HOME=cache/huggingface

FLAN_T5_MODEL_ID=google/flan-t5-base
FLAN_T5_REVISION=main
QWEN_TASK_MODEL_ID=Qwen/Qwen3-8B
QWEN_TASK_MODEL_REVISION=main

# Optional mirrors. Leave empty to use the official endpoints.
HF_ENDPOINT=
